# Copy to ".env" in this same directory and fill in real values.
# Paths are relative to the repo root unless they are absolute, or a Hugging Face id.

# --- Groq (inference --use_API groq) ---
GROQ_NAME_ID=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- DeepSeek (inference --use_API deepseek, transcribe recap) ---
DEEPSEEK_NAME_ID=deepseek
DEEPSEEK_API_KEY=
# Official: deepseek-v4-flash (fast) · deepseek-v4-pro (reasoning)
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Anthropic (Adriano_graph stage 3 extraction) ---
ANTHROPIC_API_KEY=

# --- Hugging Face (pyannote diarization in transcribe/) ---
HF_TOKEN=

# --- Embeddings (Adriano_graph stages 5–6 + inference) ---
# Hugging Face id, or a path relative to this file:
#   EMBED_MODEL=BAAI/bge-m3
#   EMBED_MODEL=../../models/embeddings/bge-m3
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cuda

# --- Neo4j Desktop (Adriano_graph/neo4j/import_to_neo4j.py) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
