# Copia come inference/.env e compila i valori reali.
# Ogni provider API usa: {PREFIX}_NAME_ID, {PREFIX}_API_KEY, {PREFIX}_MODEL
# Il nome passato a --use_API deve coincidere con *_NAME_ID.

GROQ_NAME_ID=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_NAME_ID=deepseek
DEEPSEEK_API_KEY=
# Modelli ufficiali API (https://api-docs.deepseek.com/):
#   deepseek-v4-flash  — veloce, economico (consigliato)
#   deepseek-v4-pro    — reasoning premium
# Alias legacy (deprecati 2026-07-24): deepseek-chat, deepseek-reasoner
DEEPSEEK_MODEL=deepseek-v4-flash
